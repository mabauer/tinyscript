// Symbolic expressions: evaluate, differentiate, simplify.
//
// Written with class and interface as planned (TODO.md, "Objects with methods
// are verbose"): it does not run yet. expressions_today.tys is the same
// program with constructor functions and prototypes, and runs today; both must
// print the same.
//
// class Add(left, right) { … } is short for a class whose constructor only sets
// the fields this.left and this.right (a class has either such a header or a
// constructor).
//
// The interface says what every kind of expression can do. The validator checks
// each class that says "implements Expr": a missing method, or one with a
// different number of parameters, is an error before the script runs.
interface Expr {
    evaluate(env);
    derive(name);
    simplify();
    precedence();
    toString();
}

// Constructors that simplify while they build: constants are folded, neutral
// elements dropped, a constant factor comes first.
function add(a, b) {
    if (a instanceof Num && b instanceof Num) { return new Num(a.value + b.value); }
    if (isConstant(a, 0)) { return b; }
    if (isConstant(b, 0)) { return a; }
    return new Add(a, b);
}

function sub(a, b) {
    if (a instanceof Num && b instanceof Num) { return new Num(a.value - b.value); }
    if (isConstant(b, 0)) { return a; }
    return new Sub(a, b);
}

function mul(a, b) {
    if (a instanceof Num && b instanceof Num) { return new Num(a.value * b.value); }
    if (isConstant(a, 0) || isConstant(b, 0)) { return new Num(0); }
    if (isConstant(a, 1)) { return b; }
    if (isConstant(b, 1)) { return a; }
    if (b instanceof Num) { return mul(b, a); }
    if (a instanceof Num && b instanceof Mul && b.left instanceof Num) {
        return mul(new Num(a.value * b.left.value), b.right);
    }
    return new Mul(a, b);
}

function pow(base, exponent) {
    if (exponent == 0) { return new Num(1); }
    if (exponent == 1) { return base; }
    if (base instanceof Num) { return new Num(Math.pow(base.value, exponent)); }
    return new Pow(base, exponent);
}

function isConstant(e, value) {
    return e instanceof Num && e.value == value;
}

// "a op b" with parentheses where the precedence needs them; Add, Sub and Mul
// share it (there is no extends: a function does it)
function binary(left, op, right, precedence) {
    const l = left.precedence() < precedence ? "(" + left + ")" : "" + left;
    const r = right.precedence() <= precedence ? "(" + right + ")" : "" + right;
    return l + " " + op + " " + r;
}

// A number
class Num(value) implements Expr {
    evaluate(env) { return this.value; }
    derive(name) { return new Num(0); }
    simplify() { return this; }
    precedence() { return 4; }
    toString() { return "" + this.value; }
}

// A variable, its value comes from env
class Var(name) implements Expr {
    evaluate(env) {
        const value = env[this.name];
        if (value == null) {
            throw new Error("no value for " + this.name);
        }
        return value;
    }
    derive(name) { return new Num(name == this.name ? 1 : 0); }
    simplify() { return this; }
    precedence() { return 4; }
    toString() { return this.name; }
}

// left + right
class Add(left, right) implements Expr {
    evaluate(env) { return this.left.evaluate(env) + this.right.evaluate(env); }
    derive(name) { return new Add(this.left.derive(name), this.right.derive(name)); }
    simplify() { return add(this.left.simplify(), this.right.simplify()); }
    precedence() { return 1; }
    toString() { return binary(this.left, "+", this.right, 1); }
}

// left - right
class Sub(left, right) implements Expr {
    evaluate(env) { return this.left.evaluate(env) - this.right.evaluate(env); }
    derive(name) { return new Sub(this.left.derive(name), this.right.derive(name)); }
    simplify() { return sub(this.left.simplify(), this.right.simplify()); }
    precedence() { return 1; }
    toString() { return binary(this.left, "-", this.right, 1); }
}

// left * right
class Mul(left, right) implements Expr {
    evaluate(env) { return this.left.evaluate(env) * this.right.evaluate(env); }
    derive(name) {
        // product rule: (uv)' = u'v + uv'
        return new Add(new Mul(this.left.derive(name), this.right), new Mul(this.left, this.right.derive(name)));
    }
    simplify() { return mul(this.left.simplify(), this.right.simplify()); }
    precedence() { return 2; }
    toString() { return binary(this.left, "*", this.right, 2); }
}

// base ^ exponent, the exponent is a number
class Pow(base, exponent) implements Expr {
    evaluate(env) { return Math.pow(this.base.evaluate(env), this.exponent); }
    derive(name) {
        // chain rule: (u^n)' = n * u^(n-1) * u'
        return new Mul(new Mul(new Num(this.exponent), new Pow(this.base, this.exponent - 1)), this.base.derive(name));
    }
    simplify() { return pow(this.base.simplify(), this.exponent); }
    precedence() { return 3; }
    toString() {
        const b = this.base.precedence() <= 3 ? "(" + this.base + ")" : "" + this.base;
        return b + "^" + this.exponent;
    }
}

// --- Using it ---

const x = new Var("x");
const y = new Var("y");

// f(x) = 3x² + 2x - 5
const f = new Sub(new Add(new Mul(new Num(3), new Pow(x, 2)), new Mul(new Num(2), x)), new Num(5));
const df = f.derive("x");
print("f(x)   =", f);
print("f'(x)  =", df);
print("       =", df.simplify());
for (const v : range(-2, 3)) {
    print("f(" + v + ") =", f.evaluate({ x: v }), "  f'(" + v + ") =", df.evaluate({ x: v }));
}

// Partial derivatives
const h = new Add(new Mul(x, y), new Pow(y, 3));
print("h(x, y) =", h);
print("dh/dx   =", h.derive("x").simplify());
print("dh/dy   =", h.derive("y").simplify());

// Newton's method finds a zero of g: x := x - g(x) / g'(x)
function newton(g, start, steps) {
    const dg = g.derive("x").simplify();
    print("Newton for", g, "with g'(x) =", dg);
    let value = start;
    for (const i : range(steps)) {
        value = value - g.evaluate({ x: value }) / dg.evaluate({ x: value });
        print("  step", i + 1, value);
    }
    return value;
}
const root = newton(new Sub(new Pow(x, 2), new Num(2)), 1, 5);
print("sqrt(2) =", Math.sqrt(2), " difference:", Math.abs(root - Math.sqrt(2)));

// A variable without a value
try {
    h.evaluate({ x: 1 });
}
catch (e) {
    print("Cannot evaluate", h + ":", e.message);
}
