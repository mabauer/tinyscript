// Advent of Code 2024, day 22: Monkey Market
// https://adventofcode.com/2024/day/22
//
// Usage: tinyscript day22.tys -- input.txt

import inputLines from "./aoc";

const buyers = inputLines().map(Number);

// Mixing is XOR, pruning keeps the lowest 24 bits
const PRUNE = 16777215;   // 2^24 - 1

// The next secret number: mix in the number times 64, divided by 32 and times 2048
function nextSecret(secret) {
    secret = (secret ^ (secret << 6)) & PRUNE;
    secret = (secret ^ (secret >> 5)) & PRUNE;
    return (secret ^ (secret << 11)) & PRUNE;
}

// Part 1: the 2000th secret number of each buyer, added up
// Part 2: the price is the last digit of the secret number. The monkey sells at the first time
// it sees a sequence of four price changes; find the sequence with the most bananas over all
// buyers. A sequence of four changes (-9 to 9 each) is a number in base 19.
const SEQUENCES = 19 * 19 * 19 * 19;
const bananas = new Array(SEQUENCES).fill(0);
const lastBuyer = new Array(SEQUENCES).fill(-1);   // the last buyer that has seen each sequence
let sum = 0;
for (let buyer = 0, buyers.length - 1) {
    let secret = buyers[buyer];
    let price = secret % 10;
    let sequence = 0;
    for (let step = 1, 2000) {
        secret = nextSecret(secret);
        const change = secret % 10 - price;
        price = secret % 10;
        sequence = (sequence * 19 + change + 9) % SEQUENCES;   // the last four changes
        if (step >= 4 && lastBuyer[sequence] != buyer) {
            lastBuyer[sequence] = buyer;
            bananas[sequence] += price;
        }
    }
    sum += secret;
}

print("Part 1: " + sum);
print("Part 2: " + bananas.reduce((max, count) => Math.max(max, count), 0));
