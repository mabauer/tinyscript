// Advent of Code 2024, day 3: Mull It Over
// https://adventofcode.com/2024/day/3
//
// Usage: tinyscript day03.tys -- input.txt
//
// tinyscript has no regular expressions; findAll of std:string finds the instructions.

import inputText from "./aoc";
import findAll from "std:string";

// Adds up the products of all instructions mul(X,Y), where X and Y have 1 to 3 digits
function sumOfMultiplications(memory) {
    let sum = 0;
    for (const [x, y] : findAll("mul({:d},{:d})", memory)) {
        if (x >= 0 && x < 1000 && y >= 0 && y < 1000) {
            sum += x * y;
        }
    }
    return sum;
}

// Part 2: don't() disables the multiplications that follow, do() enables them again. The
// enabled parts are the start up to the first don't() and, after each do(), the text up to
// the next don't(); a separator keeps two parts from forming a new instruction.
function enabledParts(memory) {
    return memory.split("do()").map(part => part.split("don't()")[0]).join("|");
}

const memory = inputText();
print("Part 1: " + sumOfMultiplications(memory));
print("Part 2: " + sumOfMultiplications(enabledParts(memory)));
