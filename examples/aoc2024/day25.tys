// Advent of Code 2024, day 25: Code Chronicle
// https://adventofcode.com/2024/day/25
//
// Usage: tinyscript day25.tys -- input.txt
// (the last day has only one part)

import inputLines from "./aoc";

// The schematics are blocks of 7 lines: a lock has a full top row, a key a full bottom row.
// Each is described by the heights of its five columns.
const lines = inputLines();
const locks = [];
const keys = [];
for (let i = 0, lines.length - 1, 7) {
    const schematic = lines.slice(i, i + 7);
    const heights = [0, 1, 2, 3, 4].map(col => schematic.filter(row => row[col] == "#").length - 1);
    if (schematic[0] == "#####") {
        locks.push(heights);
    }
    else {
        keys.push(heights);
    }
}

// A key fits a lock if no column overlaps: the heights add up to at most 5
function fits(lock, key) {
    return lock.every((height, col) => height + key[col] <= 5);
}

let pairs = 0;
for (const lock : locks) {
    pairs += keys.filter(key => fits(lock, key)).length;
}
print("Part 1: " + pairs);
