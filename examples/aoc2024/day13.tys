// Advent of Code 2024, day 13: Claw Contraption
// https://adventofcode.com/2024/day/13
//
// Usage: tinyscript day13.tys -- input.txt

import inputLines from "./aoc";
import integers from "std:string";

// Each machine has three lines: button A, button B and the prize, e.g.
// "Button A: X+94, Y+34", "Button B: X+22, Y+67", "Prize: X=8400, Y=5400"
const lines = inputLines();
const machines = [];
for (const i : range(0, lines.length, 3)) {
    const [ax, ay] = integers(lines[i]);
    const [bx, by] = integers(lines[i + 1]);
    const [px, py] = integers(lines[i + 2]);
    machines.push({ ax, ay, bx, by, px, py });
}

// The tokens to win the prize, 0 if it cannot be won. Pressing a times A and b times B must
// reach the prize: a * ax + b * bx = px and a * ay + b * by = py. These two equations have
// one solution (Cramer's rule); it counts if a and b are whole numbers (and not too large).
function tokens(machine, offset, maxPresses) {
    const { ax, ay, bx, by } = machine;
    const px = machine.px + offset;
    const py = machine.py + offset;
    const determinant = ax * by - ay * bx;
    const a = (px * by - py * bx) / determinant;
    const b = (ax * py - ay * px) / determinant;
    if (!Number.isInteger(a) || !Number.isInteger(b) || a < 0 || b < 0 || a > maxPresses || b > maxPresses) {
        return 0;
    }
    return 3 * a + b;
}

// Part 1: at most 100 presses per button
print("Part 1: " + machines.reduce((sum, machine) => sum + tokens(machine, 0, 100), 0));

// Part 2: the prizes are 10000000000000 further away
print("Part 2: " + machines.reduce((sum, machine) => sum + tokens(machine, 10000000000000, 1 / 0), 0));
