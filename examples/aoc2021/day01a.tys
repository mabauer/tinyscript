// Advent of Code 2021, day 1, part 1 once more: with a recursive function over neighbors
// https://adventofcode.com/2021/day/1
//
// Usage: tinyscript day01a.tys -- input.txt

import inputLines from "./aoc";
import integers, stripEmptyLines from "./utils";

// reducePairs(items, initialValue, reducerFunction) calls reducerFunction(result, fst, snd) for
// each two neighbors, like reduce for single elements. (The TypeScript original adds a method
// reduce_pairs to Array.prototype; in tinyscript, builtins cannot be extended.)
function reducePairs(items, initialValue, reducerFunction) {
    if (items.length < 2) {
        return initialValue;
    } else {
        const [fst, ...rest] = items;
        const snd = rest[0];
        const result = reducerFunction(initialValue, fst, snd);
        return reducePairs(rest, result, reducerFunction);
    }
}

// Without the empty last line: NaN < number is a TypeError in tinyscript (see day01.tys)
function part1(lines) {
    const ints = integers(stripEmptyLines(lines));
    return reducePairs(ints, 0, (result, fst, snd) => {
        if (fst < snd) {
            result += 1;
        }
        return result;
    });
}

const lines = inputLines();
print("Part 1: " + part1(lines));
