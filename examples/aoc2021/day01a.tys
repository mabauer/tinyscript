// Advent of Code 2021, day 1, part 1 once more: with a method reduce_pairs for all arrays
// https://adventofcode.com/2021/day/1
//
// Usage: tinyscript day01a.tys -- input.txt

import inputLines from "./aoc";
import integers, stripEmptyLines from "./utils";

// reduce_pairs(initialValue, reducerFunction) calls reducerFunction(result, fst, snd) for
// each two neighbors, like reduce for single elements
if (Array.prototype.reduce_pairs == undefined) {
    Array.prototype.reduce_pairs = function(initialValue, reducerFunction) {
        if (this.length < 2) {
            return initialValue;
        } else {
            // TypeScript: const [fst, ...rest] = this;
            const fst = this[0];
            const rest = this.slice(1);
            const snd = rest[0];
            const result = reducerFunction(initialValue, fst, snd);
            return rest.reduce_pairs(result, reducerFunction);
        }
    };
}

// Without the empty last line: NaN < number is a TypeError in tinyscript (see day01.tys)
function part1(lines) {
    const ints = integers(stripEmptyLines(lines));
    return ints.reduce_pairs(0, (result, fst, snd) => {
        if (fst < snd) {
            result += 1;
        }
        return result;
    });
}

const lines = inputLines();
print("Part 1: " + part1(lines));
