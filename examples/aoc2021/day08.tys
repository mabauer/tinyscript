// Advent of Code 2021, day 8: Seven Segment Search
// https://adventofcode.com/2021/day/8
//
// Usage: tinyscript day08.tys -- input.txt

import inputLines from "./aoc";
import words from "std:string";

const seven_segments = [
    "abcefg",  // 0
    "cf",      // 1
    "acdeg",   // 2
    "acdfg",   // 3
    "bcdf",    // 4
    "abdfg",   // 5
    "abdefg",  // 6
    "acf",     // 7
    "abcdefg", // 8
    "abcdfg",  // 9
];

// TypeScript: split(/\s+/) (and a console.log of each line, here left out)
function parse_line(line) {
    const [signal_values, output_values] = line.split("|");
    const signals = words(signal_values);
    const outputs = words(output_values);
    return [signals, outputs];
}

function part1(lines) {
    let count = 0;
    for (const line : lines) {
        if (line.length > 0) {
            const [signals, outputs] = parse_line(line);
            for (const digit : outputs) {
                const len = digit.length;
                if ([2, 4, 3, 7].includes(len)) {
                    count += 1;
                }
            }
        }
    }
    return count;
}

// A mapping: for each wire, the segments it can still stand for
function updateMapping(mapping, digit, signal) {
    const unused_segments = Object.keys(mapping).filter(ch => !signal.includes(ch));
    for (const s : unused_segments) {
        mapping[s] = mapping[s].filter(ch => !seven_segments[digit].includes(ch));
    }
    for (const s : signal) {
        mapping[s] = mapping[s].filter(ch => seven_segments[digit].includes(ch));
    }
}

function find_mapping(signals, pos, digits) {
    pos = pos ?? 0;
    digits = digits ?? [];
    if (pos == 10) {
        // Build an check mapping
        const mapping = {};
        for (const ch : "abcdefg") {
            mapping[ch] = "abcdefg".split("");
        }
        for (const i : range(10)) {
            updateMapping(mapping, digits[i], signals[i]);
        }
        if (Object.keys(mapping).filter(k => mapping[k].length != 1).length == 0) {
            return mapping;
        } else {
            return null;
        }
    } else {
        const signal = signals[pos];
        let new_digits = digits.slice();
        if (signal.length == 2) {
            new_digits.push(1);
            return find_mapping(signals, pos + 1, new_digits);
        }
        if (signal.length == 3) {
            new_digits.push(7);
            return find_mapping(signals, pos + 1, new_digits);
        }
        if (signal.length == 4) {
            new_digits.push(4);
            return find_mapping(signals, pos + 1, new_digits);
        }
        if (signal.length == 7) {
            new_digits.push(8);
            return find_mapping(signals, pos + 1, new_digits);
        }
        if (signal.length == 5) {
            for (const digit : [2, 3, 5].filter(d => !digits.includes(d))) {
                new_digits.push(digit);
                const tmp = find_mapping(signals, pos + 1, new_digits);
                if (tmp != null) {
                    return tmp;
                } else {
                    new_digits = digits.slice();
                }
            }
        }
        if (signal.length == 6) {
            for (const digit : [0, 6, 9].filter(d => !digits.includes(d))) {
                new_digits.push(digit);
                const tmp = find_mapping(signals, pos + 1, new_digits);
                if (tmp != null) {
                    return tmp;
                } else {
                    new_digits = digits.slice();
                }
            }
        }
    }
}

function convert_output(input, mapping) {
    const segments = input.split("")
        .map(ch => mapping[ch][0])
        .sort()
        .join("");
    const digit = seven_segments.indexOf(segments);
    return digit;
}

function part2(lines) {
    let sum = 0;
    for (const line : lines) {
        if (line.length > 0) {
            const [signals, outputs] = parse_line(line);
            const mapping = find_mapping(signals);
            const digits = outputs.map(o => convert_output(o, mapping));
            const output = parseInt(digits.join(""));
            sum += output;
        }
    }
    return sum;
}

const lines = inputLines();
print("Part 1: " + part1(lines));
print("Part 2: " + part2(lines));
