let fibonacci = function() {
	let i;
 	let fib = [];
 	fib[0] = 1;
 	fib[1] = 1;
 	for (i : range(2, 101)) {
  		fib[i] = fib[i-2] + fib[i-1];
 	}
 	return fib;
};

let bench = function(times) {
	let start = System.currentTimeMillis();
 	for (const n : range(1, times + 1)) {
  		fibonacci();
 	}
 	let duration = times + ": " + (System.currentTimeMillis() - start);
 	print(duration);
};

bench(10000);
bench(100000);