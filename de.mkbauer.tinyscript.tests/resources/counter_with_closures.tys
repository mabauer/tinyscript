// returns counter object
let createCounter = function createCounter() {
  let value = 0; // used by add, sub, val
  return {
    add: function(x) { value = value + x; },
    sub: function(x) { value = value - x; },
    val: function() { return value;}
  };
};
 
// create two counters
let counter1 = createCounter();
let counter2 = createCounter();
 
// use the counters
counter1.add(14);
counter2.add(32);
let val1 = counter1.val();
let val2 = counter2.val();
counter1.sub(4);
let val3 = counter1.val();

// the result: val1 is 14, val2 is 32, val3 is 10
assert (val1==14);
assert (val2==32);
assert (val3==10);
 
