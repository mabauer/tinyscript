// Compute prime numbers

const n = 15000;

const primes = [];

for (const i : range(1, n + 1)) {
	primes[i] = true;	
}
	
for (const i : range(2, Math.floor(n/2) + 1)) {
  for (const j : range(2, Math.floor(n/i) + 1)) { 
  	primes[(i*j)]=false;
  }
}

for (const i : range(n + 1)) {
	if (primes[i]) {
		print(i);	
	}
}