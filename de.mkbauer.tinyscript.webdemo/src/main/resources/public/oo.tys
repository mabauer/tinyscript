// Objects and classes.

// An object literal with properties and methods (greet() { ... } is short for
// greet: function() { ... }); this is the object the method is called on
const alice = {
    name: "Alice",
    greet(other) {
        return "Hello " + other + ", I'm " + this.name;
    }
};
print(alice.greet("Bob"));

// A class: the constructor gives each new object its fields, the methods are
// shared by all objects of the class
class Account {
    constructor(owner, balance) {
        this.owner = owner;
        this.balance = balance;
    }

    deposit(amount) {
        this.balance += amount;
        return this;
    }

    withdraw(amount) {
        if (amount > this.balance) {
            throw new Error("only " + this.balance + " left");
        }
        this.balance -= amount;
        return this;
    }
}

const account = new Account("Alice", 100);
account.deposit(50).withdraw(30);
print(account);                     // print shows the class and the fields
try {
    account.withdraw(500);
}
catch (e) {
    print("Refused:", e.message);
}

// Objects of different classes with the same methods can be used alike
class Circle {
    constructor(radius) {
        this.radius = radius;
    }
    area() { return Math.PI * this.radius * this.radius; }
    toString() { return "circle with radius " + this.radius; }
}

class Square {
    constructor(side) {
        this.side = side;
    }
    area() { return this.side * this.side; }
    toString() { return "square with side " + this.side; }
}

for (const shape : [new Circle(1), new Square(2)]) {
    print(shape + ": area " + shape.area().toFixed(2));
}

// A class is a constructor function with the methods on its prototype; there
// is no inheritance (extends). Without class, an object can inherit directly
// from another one with Object.create:
const animal = {
    describe() { return this.name + " says " + this.sound(); },
    sound() { return "..."; }
};
const dog = Object.create(animal);
dog.name = "Rex";
dog.sound = function() { return "woof"; };
print(dog.describe(), Object.getPrototypeOf(dog) == animal, Object.keys(dog));
print(typeof Account, account instanceof Account, Object.keys(account));
