<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>de.mkbauer.tinyscript.repl</groupId>
	<artifactId>de.mkbauer.tinyscript.repl</artifactId>
	<version>0.17.0</version>
	<name>TinyscriptREPL</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>25</maven.compiler.release>
		<xtext-version>2.44.0</xtext-version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- Override the Guava version from the Eclipse target platform (core POM): CVE-2026-102554 is fixed in 33.7.2 -->
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>33.8.0-jre</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>de.mkbauer.tinyscript</groupId>
			<artifactId>de.mkbauer.tinyscript</artifactId>
			<version>0.17.0</version>
			<!-- OSGi runtime / Eclipse UI libraries pulled in by the Tycho-generated core POM; not needed standalone -->
			<exclusions>
				<exclusion>
					<groupId>org.osgi</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.felix</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.aries.spifly</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>net.java.dev.jna</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.github.weisj</groupId>
					<artifactId>jsvg</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.ibm.icu</groupId>
					<artifactId>icu4j</artifactId>
				</exclusion>
				<exclusion>
					<groupId>commons-cli</groupId>
					<artifactId>commons-cli</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext.util</artifactId>
			<version>${xtext-version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext.common.types</artifactId>
			<version>${xtext-version}</version>
		</dependency>
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr-runtime</artifactId>
			<version>3.2</version>
			<!-- StringTemplate (and ANTLR 2) are only needed by the ANTLR tool, not the runtime -->
			<exclusions>
				<exclusion>
					<groupId>org.antlr</groupId>
					<artifactId>stringtemplate</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>jline</groupId>
			<artifactId>jline</artifactId>
			<version>2.14.6</version>
		</dependency>
		<dependency>
			<groupId>com.google.inject</groupId>
	    	<artifactId>guice</artifactId>
	    	<version>7.0.0</version>
		</dependency>
	</dependencies>

	<build>
		<sourceDirectory>${basedir}/src/</sourceDirectory>
		<scriptSourceDirectory>${basedir}/src/scripts</scriptSourceDirectory>
		<testSourceDirectory>${basedir}/tests</testSourceDirectory>
		<outputDirectory>${basedir}/target/classes</outputDirectory>
		<resources>
     		<resource>
       			<directory>${basedir}/resources</directory>
     		</resource>
     	</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<shadedArtifactAttached>true</shadedArtifactAttached>
             				<shadedClassifierName>shade</shadedClassifierName>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>de.mkbauer.tinyscript.repl.TinyscriptReplMain</mainClass>
								</transformer>
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  					<resource>plugin.properties</resource>
               					 </transformer>
							</transformers>
							<filters>
						   		<filter>
									<artifact>org.eclipse.platform:org.eclipse.equinox.common</artifact>
									<includes>
										<include>org/eclipse/core/runtime/*</include>
									</includes>
								</filter>
								<!-- The command line tool does not need OSGI stuff
								 -->
								<filter>
									<artifact>org.eclipse.platform:org.eclipse.osgi</artifact>
									<excludes>
										<exclude>**</exclude>
									</excludes>
								</filter>
								<!-- <filter>
									<artifact>jline:jline</artifact>
									<excludes>
										<exclude>org/fusesource/**</exclude>
									</excludes>
								</filter>
								-->
								<!-- Omit xtext.util's empty plugin.properties, 
									 because we assemble one (see transformer above) -->
								<filter>
									<artifact>org.eclipse.xtext:org.eclipse.xtext.util</artifact>
									<excludes>
										<exclude>plugin.properties</exclude>
									</excludes>
								</filter>								
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<!-- For now, exclude the module-info.classes of Java 9 and above
											 TODO: Find a better solution -->
										<exclude>module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
