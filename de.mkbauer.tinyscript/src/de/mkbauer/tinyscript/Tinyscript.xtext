grammar de.mkbauer.tinyscript.Tinyscript hidden(WS, ML_COMMENT, SL_COMMENT)

import "http://www.eclipse.org/emf/2002/Ecore" as ecore

generate ts "http://www.mkbauer.de/tinyscript/Tinyscript"

Tinyscript :
	(imports += ImportStatement)*
	global=Global
;

// import a, b from "path";  or  import * as m from "path";
ImportStatement:
	'import' ( ('*' 'as' namespace=Identifier) | (names += Identifier (',' names += Identifier)*) ) 'from' path=STRING ';'
;

Global returns Block:
	{Block}
	(statements += Statement)*
;

Block: 
	{Block}
	'{' (statements += Statement)* '}'	
;

Statement:
	(=> FunctionDeclaration) | 
	ClassDeclaration |
	InterfaceDeclaration |
	(=> BlockStatement) |
	VariableStatement | 
	ExpressionStatement | 
	ReturnStatement | 
	IfStatement |
	ForStatement |
	WhileStatement |
	BreakStatement |
	ContinueStatement |
	ThrowStatement |
	TryStatement |
	AssertStatement |
	EmptyStatement
;

EmptyStatement:
	';'
;

BlockStatement:
	block = Block
;

FunctionDeclaration returns FunctionDefinition:
	{FunctionDeclaration}
	(exported ?= 'export')? 'function' ( id=Identifier ) 
	( '(' (params += Parameter (',' params += Parameter)* (',' '...' rest=Identifier)?)? ')' 
		| '(' '...' rest=Identifier ')'  )
	block=Block 
;

// class Num { constructor(value) { ... } evaluate(env) { ... } }: a constructor function with
// methods on its prototype, without inheritance (the validator allows it only at the top level)
ClassDeclaration:
	=>((exported ?= 'export')? 'class') id=Identifier
	('implements' interfaces += Reference (',' interfaces += Reference)*)?
	'{' (methods += ClassMethod)* '}'
;

// interface Shape { area(); scale(factor); }: the methods that a class with implements Shape
// must have. The parameters are only for the reader; the names are checked when the class is
// declared (the validator checks a class and an interface of the same file before the run)
InterfaceDeclaration:
	=>((exported ?= 'export')? 'interface') id=Identifier '{' (methods += InterfaceMethod)* '}'
;

InterfaceMethod:
	name=PropertyName '(' (params += ID (',' params += ID)* (',' '...' rest=ID)? | '...' rest=ID)? ')' ';'
;

// A method of a class; the one named constructor initializes a new object
ClassMethod:
	name=PropertyName function=MethodDefinition
;

// i++; and i--; are only statements, not expressions
ExpressionStatement:
	expr=AssignmentExpression (increment=Increment)? ';'
;

// An object of its own, so that it is null if there is none (an enum attribute is never null)
Increment:
	op=IncrementOperator
;

AssignmentExpression returns Expression:
	ArrowFunctionOrConditional ({BinaryExpression.left=current} op=AssignmentOperator right=AssignmentExpression)?	
;

// cond ? a : b; unlike Javascript, b cannot be an assignment (c ? a : b = 1 is (c ? a : b) = 1, an error)
ConditionalExpression returns Expression:
	CoalesceExpression ({ConditionalExpression.cond=current} '?' then=AssignmentExpression ':' else=ArrowFunctionOrConditional)?
;

// Where an arrow function can stand, it is tried first (=>, a syntactic predicate): only the =>
// tells (a = 1) => a (a parameter with a default) from the assignment in parentheses (a = 1).
// The predicate covers only the parameters and the =>, so that a mistake in the body is
// reported where it is (not as an unexpected =>).
ArrowFunctionOrConditional returns Expression:
	=>(ArrowFunctionHead '=>') block=ArrowFunctionBlock
	| ConditionalExpression
;

// The parameters of an arrow function: x, (a, b = 1), ([x, y]) or (...rest)
ArrowFunctionHead returns FunctionDefinition:
	{ArrowFunction}
	( (params+=Identifier) 
		| ( '(' (params += Parameter (',' params += Parameter)* (',' '...' rest=Identifier)?)? ')')
		| ( '(' '...' rest=Identifier ')' )
	)
;

// x => expr returns expr; x => { ... } is a function body (without return, the result is undefined).
// Like Javascript, a { after => always starts a block: x => ({ ... }) returns an object.
ArrowFunctionBlock returns Block:
	=>({Block} '{') (statements += Statement)* '}' | {ArrowExpressionBody} statements += ExpressionStatementWithoutSemicolon
;

ExpressionStatementWithoutSemicolon returns ExpressionStatement:
	expr=ArrowFunctionOrConditional
;

// a ?? b: b if a is null or undefined. Like Javascript, it cannot be mixed with && or ||
// without parentheses (checked by the validator).
CoalesceExpression returns Expression:
	OrExpression ({BinaryExpression.left=current} op=NullishOperator right=OrExpression)*
;

OrExpression returns Expression:
	AndExpression ({BinaryExpression.left=current} op=OrOperator right=AndExpression)*
;

AndExpression returns Expression:
	BitOrExpression ({BinaryExpression.left=current} op=AndOperator right=BitOrExpression)*
;

// Bitwise operators on integers up to 53 bits, with the precedence of Javascript: & before ^ before |
BitOrExpression returns Expression:
	BitXorExpression ({BinaryExpression.left=current} op=BitOrOperator right=BitXorExpression)*
;

BitXorExpression returns Expression:
	BitAndExpression ({BinaryExpression.left=current} op=BitXorOperator right=BitAndExpression)*
;

BitAndExpression returns Expression:
	EqualityExpression ({BinaryExpression.left=current} op=BitAndOperator right=EqualityExpression)*
;

EqualityExpression returns Expression:
	CompareExpression ({BinaryExpression.left=current} op=EqualityOperator right=CompareExpression)?
;

CompareExpression returns Expression:
	ShiftExpression ({BinaryExpression.left=current} op=CompareOperator right=ShiftExpression)?
;

ShiftExpression returns Expression:
	Addition ({BinaryExpression.left=current} op=ShiftOperator right=Addition)*
;

Addition returns Expression:
	Multiplication ({BinaryExpression.left=current} op=AdditiveOperator right=Multiplication)*
;

Multiplication returns Expression:
    (Unary | Primary ) ({BinaryExpression.left=current} op=MultiplicativeOperator right=(Unary | Primary ))*
;

Unary:
	op=UnaryOperator expr=(Unary | Primary)
;

Primary returns Expression:
	((Atomic  | NewExpression | GroupingExpression ) ({CallOrPropertyAccess.expr=current} suffix=(CallOrPropertyAccessSuffix|CallSuffix))* )
	| NullObject
	| UndefinedLiteral
;

GroupingExpression:
	'(' expr=AssignmentExpression ')'
;

NewExpression:
	'new' (expr=Atomic | => '(' expr=AssignmentExpression ')' )
;

Atomic:
	Reference |
	BooleanLiteral |
	NumberLiteral |
    StringLiteral |
    ObjectInitializer |
    ArrayInitializer | 
    FunctionExpression
;

FunctionExpression returns FunctionDefinition:
	'function' ( id=Identifier )? 
		( '(' (params += Parameter (',' params += Parameter)* (',' '...' rest=Identifier)?)? ')' 
		| '(' '...' rest=Identifier ')'  )
	block=Block 
;

ReturnStatement:
	{ReturnStatement}
	'return' (expr=AssignmentExpression)? ';'
;

AssertStatement:
	'assert' cond=AssignmentExpression ';'
;

IfStatement:
	'if' '(' cond=AssignmentExpression ')' then=Block
	(else=ElseStatement)?
	;
	
ElseStatement:
	'else' (else=Block | elseIf=IfStatement)
;

ForStatement:
	'for' '(' ((kind=DeclarationKind (id=Identifier | pattern=Pattern)) | ref=Reference) iterableForExpr=IterableForExpression ')' do=Block
;

IterableForExpression:
	':' iterable=Addition 
;

WhileStatement:
	'while' '(' cond=AssignmentExpression ')' do=Block
;

BreakStatement:
	{BreakStatement}
	'break' ';'
;

ContinueStatement:
	{ContinueStatement}
	'continue' ';'
;

// throw new Error("..."): only Error objects can be thrown
ThrowStatement:
	'throw' expr=AssignmentExpression ';'
;

// try { ... } catch (e) { ... }, or catch { ... } without the error; no finally. It catches only
// what a script may expect: errors thrown with throw and failed input / output (std:fs);
// programming errors (TypeError ...), failed asserts and resource limits end the script
TryStatement:
	'try' block=Block handler=CatchClause
;

CatchClause:
	'catch' ('(' param=Identifier ')')? block=Block
;

VariableStatement:
	(exported ?= 'export')? kind=DeclarationKind (vardecls += VariableDeclaration) (',' vardecls += VariableDeclaration)* ';'
;

VariableDeclaration returns Expression:
	Identifier ({BinaryExpression.left=current} op=PlainAssignmentOperator right=AssignmentExpression)? |
	Pattern {BinaryExpression.left=current} op=PlainAssignmentOperator right=AssignmentExpression
;

// A parameter: a name, or a pattern like function f([x, y]) or ({ row, col }) => row + col.
// A name can have a default, function f(x, step = 1), used when the argument is undefined
Parameter returns Expression:
	ParameterName | Pattern
;

ParameterName returns Identifier:
	name=ID ('=' defaultValue=AssignmentExpression)?
;

// Destructuring, only flat: var [a, b] = pair; var { row, col } = position;
Pattern:
	ArrayPattern | ObjectPattern
;

// An array pattern can end with a rest element, [first, ...rest], that gets the other elements
ArrayPattern:
	'[' ( names += Identifier (',' names += Identifier)* (',' '...' rest=Identifier)?
		| '...' rest=Identifier ) ']'
;

ObjectPattern:
	'{' names += Identifier (',' names += Identifier)* '}'
;

Reference:
	id=[Identifier] | this?='this'  
;

Identifier:
	name=ID
;

CallOrPropertyAccessSuffix:
	{CallOrPropertyAccessSuffix}
	(property=PropertyAccessSuffix) =>(call=CallSuffix)?
;

CallSuffix:
	{CallSuffix}
	'(' (arguments += Argument (',' arguments += Argument)*)? ')' 
;

// An argument of a call or an element of an array literal: a value, or ...items, the items of an
// array, a string, a Map, a Set or a range one by one: Math.max(...values), [...a, x]
Argument returns Expression:
	SpreadElement | AssignmentExpression
;

SpreadElement:
	'...' expr=AssignmentExpression
;

PropertyAccessSuffix:
	ComputedPropertyAccessSuffix | DotPropertyAccessSuffix
;

// a?.[key] and a?.key: undefined (for the whole chain) if a is null or undefined
ComputedPropertyAccessSuffix:
	(optional?='?.')? '[' key=AssignmentExpression ']'
;
	
DotPropertyAccessSuffix:
	('.' | optional?='?.') key=PropertyName 
;

// Like Javascript, a comma after the last property is allowed: { a: 1, b: 2, }
ObjectInitializer:
	{ObjectInitializer}
	'{' (propertyassignments+=PropertyAssignment (',' propertyassignments+=PropertyAssignment)* ','?)? '}'
;

// key: value, the method shorthand { greet() { ... } } for { greet: function() { ... } },
// or the shorthand { row, col } for { row: row, col: col }
PropertyAssignment:
	key=PropertyName (':' value=AssignmentExpression | value=MethodDefinition) | shorthand=Reference
;

// The parameters and body of a method in an object literal: greet(name) { ... }
MethodDefinition returns FunctionDefinition:
	{FunctionDefinition}
	( '(' (params += Parameter (',' params += Parameter)* (',' '...' rest=Identifier)?)? ')'
	| '(' '...' rest=Identifier ')'  )
	block=Block
;

PropertyName:
	expr=StringLiteral |
	name=(ID | Keyword)
;

// Like Javascript, a comma after the last element is allowed: [1, 2, ]; unlike Javascript,
// there are no empty elements ([1, , 2])
ArrayInitializer:
	{ArrayInitializer}
	'[' (values+=Argument (',' values += Argument)* ','?)? ']'
;

NullObject returns Expression:
	{NullObject}
	'null'
;

// Unlike Javascript, where undefined is a global variable, a literal like null: it cannot
// be declared, assigned or shadowed
UndefinedLiteral returns Expression:
	{UndefinedLiteral}
	'undefined'
;

StringLiteral:
	value=STRING
;

BooleanLiteral:
	value=BOOLEAN
;

NumberLiteral:
	value=DOUBLE
;

// The operators are enums in the syntax tree (not strings), so that the interpreter switches
// over them directly. All binary operators are literals of BinaryOperator; each level of
// precedence has a rule with the operators allowed there.

enum PlainAssignmentOperator returns BinaryOperator:
	ASSIGN='='
;

enum AssignmentOperator returns BinaryOperator:
	ASSIGN='=' | ADD_ASSIGN='+=' | SUBTRACT_ASSIGN='-=' | MULTIPLY_ASSIGN='*=' | DIVIDE_ASSIGN='/='
	| REMAINDER_ASSIGN='%=' | BIT_AND_ASSIGN='&=' | BIT_OR_ASSIGN='|=' | BIT_XOR_ASSIGN='^='
	| SHIFT_LEFT_ASSIGN='<<=' | SHIFT_RIGHT_ASSIGN='>>='
;

enum NullishOperator returns BinaryOperator:
	NULLISH='??'
;

enum OrOperator returns BinaryOperator:
	OR='||'
;

enum AndOperator returns BinaryOperator:
	AND='&&'
;

enum BitOrOperator returns BinaryOperator:
	BIT_OR='|'
;

enum BitXorOperator returns BinaryOperator:
	BIT_XOR='^'
;

enum BitAndOperator returns BinaryOperator:
	BIT_AND='&'
;

enum EqualityOperator returns BinaryOperator:
	EQUALS='==' | NOT_EQUALS='!='
;

enum CompareOperator returns BinaryOperator:
	LESS='<' | LESS_OR_EQUAL='<=' | GREATER='>' | GREATER_OR_EQUAL='>=' | INSTANCEOF='instanceof'
;

enum ShiftOperator returns BinaryOperator:
	SHIFT_LEFT='<<' | SHIFT_RIGHT='>>'
;

enum AdditiveOperator returns BinaryOperator:
	ADD='+' | SUBTRACT='-'
;

enum MultiplicativeOperator returns BinaryOperator:
	MULTIPLY='*' | DIVIDE='/' | REMAINDER='%'
;

enum UnaryOperator:
	NEGATE='-' | NOT='!' | BIT_NOT='~' | TYPEOF='typeof' | DELETE='delete'
;

// i++; and i--; (only statements)
enum IncrementOperator:
	INCREMENT='++' | DECREMENT='--'
;

// Javascript keywords that tinyscript does not support. They are reserved, so that the parser
// can say so (TinyscriptSyntaxErrorMessageProvider); like in Javascript, they are fine as
// property names (o.switch, { case: 1 }).
ReservedWord:
	'finally' | 'switch' | 'case' | 'var'
;

// All keywords of tinyscript: they cannot be names of variables, but like in Javascript, they
// are fine as property names (range.from, { if: 1 })
Keyword:
	ReservedWord | 'let' | 'const' | 'function' | 'class' | 'interface' | 'implements' | 'return' | 'if' | 'else' | 'for' | 'while' | 'break'
	| 'continue' | 'throw' | 'try' | 'catch' | 'new' | 'this' | 'null' | 'undefined' | 'typeof' | 'delete' | 'instanceof' | 'assert' | 'import' | 'export' | 'from' | 'as'
;

// let is block-scoped (like Javascript's let); const cannot be assigned again. var is a reserved
// word: the syntax error says to use let
DeclarationKind:
	'let' | 'const'
;

terminal BOOLEAN returns ecore::EBoolean:
	'true' | 'false'
;

// Numbers as in Javascript: 42, 3.14, .5, 1e-9, 0xff, 0b1010, 0o17, and with separators
// between digits, 1_000_000. The lexer takes digits and _ generously, so that
// TinyscriptValueConverter can say what is wrong (1__000, 0b102) and computes the value.
terminal DOUBLE returns ecore::EDouble:
    '0' ('x' | 'X') ('0'..'9' | 'a'..'f' | 'A'..'F' | '_')*
    | '0' ('b' | 'B' | 'o' | 'O') ('0'..'9' | '_')*
    | (DIGITS ('.' DIGITS?)? | '.' DIGITS) (('e' | 'E') ('+' | '-')? ('0'..'9' | '_')+)?;

terminal fragment DIGITS: ('0'..'9') ('0'..'9' | '_')*;
    
terminal ID  		: '^'?('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'_'|'0'..'9')*;

terminal STRING	: 
			'"' ( '\\' ('b'|'t'|'n'|'f'|'r'|'u'|'"'|"'"|'\\') | !('\\'|'"') )* '"' |
			"'" ( '\\' ('b'|'t'|'n'|'f'|'r'|'u'|'"'|"'"|'\\') | !('\\'|"'") )* "'"
		; 
terminal ML_COMMENT	: '/*' -> '*/';
terminal SL_COMMENT 	: '//' !('\n'|'\r')* ('\r'? '\n')?;

terminal WS			: (' '|'\t'|'\r'|'\n')+;

terminal ANY_OTHER: .;