// Standard library: helpers for collections.  import sum, max, reverse from "std:array";
// (They work on anything the for loop goes through: arrays, ranges, strings, Sets and Maps.)

// The sum of the numbers in items
export function sum(items) {
	let result = 0;
	for (const x : items) {
		result = result + x;
	}
	return result;
}

// Whether items contains an element == x (a string: a single character; use includes for a
// substring). The elements of a Map are [key, value] pairs, which == never matches: use has(key).
export function contains(items, x) {
	if (Array.isArray(items)) {
		return items.indexOf(x) >= 0;
	}
	if (items instanceof Set) {
		return items.has(x);
	}
	for (const item : items) {
		if (item == x) {
			return true;
		}
	}
	return false;
}

// A new array with the elements of items in reverse order
export function reverse(items) {
	let all = items;
	if (!Array.isArray(items)) {
		all = [];
		for (const item : items) {
			all.push(item);
		}
	}
	// Writing by index is much faster than push (a method call per element)
	const n = all.length;
	const result = new Array(n);
	for (const i : range(n)) {
		result[n - 1 - i] = all[i];
	}
	return result;
}

// The smallest element of items: numbers, or strings (compared with <); an error if there is none
export function min(items) {
	return extreme("min", items, (a, b) => a < b);
}

// The largest element of items: numbers, or strings (compared with >); an error if there is none
export function max(items) {
	return extreme("max", items, (a, b) => a > b);
}

// The element that is better than all others, by better(a, b)
function extreme(name, items, better) {
	let result = undefined;
	let first = true;
	for (const x : items) {
		if (first || better(x, result)) {
			result = x;
		}
		first = false;
	}
	if (first) {
		throw new Error(name + ": there are no elements");
	}
	return result;
}
